# Example environment configuration.
# Copy to `.env` and adjust. CLI flags always override these values.
# Precedence: CLI argument > .env value > built-in default.

# Directory containing the source images.
INPUT_DIR=./photos

# Output MP4 file path.
OUTPUT_FILE=./output/slideshow.mp4

# Seconds each image is shown (default 5).
DELAY_SECONDS=5

# Transition between images: "cut" or "crossfade" (default cut).
TRANSITION=cut

# Crossfade duration in seconds (only used when TRANSITION=crossfade).
CROSSFADE_SECONDS=1

# Target resolution WIDTHxHEIGHT. Must be even (default 1920x1080).
RESOLUTION=1920x1080

# Overwrite the output file if it already exists: true/false.
OVERWRITE=false

# Apply a subtle slow zoom/pan (Ken Burns) to each image: true/false.
KEN_BURNS=false

# Video encoder. Default "auto" detects the best available hardware encoder
# (h264_nvenc > h264_qsv > h264_videotoolbox) and falls back to libx264.
# Explicit: libx264, h264_nvenc, h264_qsv, h264_vaapi, h264_videotoolbox.
ENCODER=auto
