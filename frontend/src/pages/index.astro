---
import App from "../components/App.tsx";
import ThemeToggle from "../components/ThemeToggle.tsx";

const encoderChoices = [
  ["auto", "Auto (GPU if available)"],
  ["libx264", "CPU (libx264)"],
  ["h264_nvenc", "NVIDIA GPU (NVENC)"],
  ["h264_qsv", "Intel GPU (QuickSync)"],
  ["h264_videotoolbox", "macOS (VideoToolbox)"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Photo Slideshow Maker</title>
    <style>
      :root {
        --bg: #0f172a;
        --card: #1e293b;
        --input-bg: #0f172a;
        --accent: #6366f1;
        --text: #e2e8f0;
        --muted: #94a3b8;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        transition: background 0.3s, color 0.3s;
      }
      .container { max-width: 880px; margin: 0 auto; padding: 2rem 1rem 4rem; }
      h1 { margin: 0 0 0.25rem; }
      .sub { color: var(--muted); margin-top: 0; }
      a { color: var(--accent); }
    </style>
  </head>
  <body>
    <ThemeToggle client:load />
    <main class="container">
      <h1>Photo Slideshow Maker</h1>
      <p class="sub">
        Turn a folder of images into an MP4. GPU-accelerated (NVENC) when
        available, CPU otherwise.
      </p>
      <App client:load encoderChoices={encoderChoices} />
    </main>
  </body>
</html>
